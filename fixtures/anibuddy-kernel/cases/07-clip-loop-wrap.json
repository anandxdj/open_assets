      { "id": "head", "parent": "spine", "x": 0.5, "y": 0.24 }
    ],
    "parts": [
      {
        "id": "headPlate",
        "zIndex": 1,
        "deformer": { "kind": "rigid" },
        "rect": [0.34, 0.1, 0.66, 0.38],
