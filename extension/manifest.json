{
  "manifest_version": 3,
  "name": "OpenAssets - AI Asset Extractor",
  "version": "1.0.0",
  "description": "Extract sprite sheets, manga panels, UI elements, and icons directly from any webpage using AI-powered OpenCV detection.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "notifications",
    "downloads"
  ],
  "host_permissions": [
    "https://*.anands.dev/*",
    "http://localhost:4000/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "extract-image": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Alt+Shift+E"
      },
      "description": "Extract assets from the last hovered image"
    }
  }
}
