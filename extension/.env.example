# Build-time configuration for the OpenAssets extension.
#
# Copy this file to `.env` (gitignored) before `pnpm build`, `pnpm zip` or
# `pnpm dev`. WXT loads `.env`, `.env.local`, `.env.<mode>` and so on; a value
# set in the shell wins over the file. Both URLs are inlined into the bundle
# at build time, and the API origin is also written into the manifest's
# host_permissions, so rebuild after changing them.
#
# Leave a variable empty (or delete it) to use the production default.

# Backend API the extension calls (upload, extension sign-in, token refresh).
# Must be https, except http://localhost or http://127.0.0.1 for local work.
# Default: https://openasset-backend.anands.dev
WXT_PUBLIC_API_URL=

# Web app the extension signs in through (/extension/connect), opens the editor
# in, and links to. Same https rule. Default: https://openassets.anands.dev
WXT_PUBLIC_FRONTEND_URL=

# Local development against the dev stack (backend :4104, frontend :3104):
# WXT_PUBLIC_API_URL=http://localhost:4104
# WXT_PUBLIC_FRONTEND_URL=http://localhost:3104

# Optional. Public key from the Chrome Web Store dashboard (Package tab, "View
# public key"). Setting it makes unpacked builds use the same extension ID as
# the store build, so the backend's EXTENSION_ORIGINS entry stays valid.
# Leave it unset for the build you upload to the store.
# EXTENSION_PUBLIC_KEY=
