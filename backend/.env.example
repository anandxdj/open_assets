# OpenAssets backend (Express API + BullMQ workers).
# Copy to .env for local runs. With Docker Compose, values come from the root .env
# (see ../.env.example) and compose points the data stores and service URLs at its
# own containers, so you only set the secrets there.
#
# The server checks this file at startup (src/common/config/env.ts) and exits with a
# list of what is wrong. "Required in production" values may stay empty in development.

# ── Server ──────────────────────────────────────────────────────────────────
# development | production. production turns on strict validation, Secure cookies,
# CORS limited to the origins below and hides error details from API responses.
NODE_ENV=development
PORT=4000
# How long a shutdown (SIGTERM) may take before the process exits anyway, in ms.
# Keep it below the container stop timeout (compose uses 30s).
SHUTDOWN_TIMEOUT_MS=25000

# ── Data stores ─────────────────────────────────────────────────────────────
# Required. A mongodb:// or mongodb+srv:// connection string, without a database name.
MONGO_URI=mongodb://localhost:27017
# Database name. Set it in production so data never lands in MongoDB's default "test".
MONGO_DB_NAME=open_assets
# Required in production. Job state (24h TTL) and BullMQ queues live here.
REDIS_URL=redis://127.0.0.1:6379

# ── Neighbouring services ───────────────────────────────────────────────────
# Required in production. Public URL of the web app, no trailing slash. Used for the
# CORS allow-list and for links in emails and OAuth redirects.
FRONTEND_URL=http://localhost:3000
# Required in production. Internal URL of the Python AI service.
PY_BACKEND_URL=http://localhost:8000
# Shared secret sent to the Python service as X-Internal-Token. Must equal
# INTERNAL_API_TOKEN in py_backend/.env. Empty disables the check (development only).
INTERNAL_API_TOKEN=
# Shared secret the Next.js Studio routes send for credit refunds. Must equal
# INTERNAL_SERVICE_TOKEN in frontend/.env.local. Refunds fail while it is empty.
INTERNAL_SERVICE_TOKEN=change-me-service-token

# ── CORS ────────────────────────────────────────────────────────────────────
# FRONTEND_URL is always allowed. Add more comma-separated origins here (scheme +
# host [+ port], no path or trailing slash), e.g. https://admin.example.com
CORS_ORIGINS=
# The browser extension's origin: chrome-extension://<32-letter extension id>.
# Required in production for the extension to reach the API. Outside production any
# localhost port and any unpacked extension are allowed automatically.
EXTENSION_ORIGINS=

# ── Cookies (the refresh token) ─────────────────────────────────────────────
# Defaults: production = Secure + SameSite=None, development = not Secure + Lax.
# true | false. The cookie is only sent over HTTPS when true. Keep true in production.
# COOKIE_SECURE=true
# lax | strict | none. Use "lax" when the web app and the API share a registrable domain
# (app.example.com + api.example.com). Use "none" (requires COOKIE_SECURE=true) when they
# are on different sites.
# COOKIE_SAMESITE=lax
# Optional cookie domain, e.g. .example.com to share the cookie across subdomains.
# COOKIE_DOMAIN=

# ── Object storage (pick one provider) ──────────────────────────────────────
# cloudinary (default) | imagekit
STORAGE_PROVIDER=cloudinary
# Required in production when STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Required in production when STORAGE_PROVIDER=imagekit
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── Auth ────────────────────────────────────────────────────────────────────
# Required in production: two different random strings of 32+ characters, for example
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Token lifetimes (optional). Defaults: 15m access, 7d refresh.
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# Google sign-in (optional). Set all three or none. Create an OAuth client in Google
# Cloud Console and add GOOGLE_CALLBACK_URL as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Verification and password-reset emails. Without a key they are only printed to the
# log. With a key, RESEND_FROM_EMAIL must be an address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Display name on those emails (optional, defaults to OpenAssets).
RESEND_FROM_NAME=OpenAssets
