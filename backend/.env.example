PORT=4000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/open_assets
MONGO_DB_NAME=open_assets
REDIS_URL=redis://127.0.0.1:6379

# Object storage for uploads and AI transforms (upscale, background removal).
# STORAGE_PROVIDER is "cloudinary" (default) or "imagekit". Without the active
# provider's credentials the API still runs, and AI enhance reports "not configured".
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Used when STORAGE_PROVIDER=imagekit
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

PY_BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

GEMINI_API_KEY=

# Studio credits — shared secret for the Next.js studio proxy's refund calls
INTERNAL_SERVICE_TOKEN=change-me-service-token
