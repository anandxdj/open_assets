# OpenAssets AI service (FastAPI + OpenCV): detection, asset naming and cropping.
# Copy to .env for local runs. With Docker Compose these values come from the root
# .env (see ../.env.example). Every key is optional here, but crops are uploaded to
# Cloudinary (unless the backend uses local storage), so uploads fail without the CLOUDINARY_* keys.

# Same Cloudinary account as the backend when STORAGE_PROVIDER=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini (asset naming) — fallback provider. Key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Open Quota (asset naming) — primary provider, tried before Gemini.
# Empty key = Gemini-only, i.e. unchanged behaviour.
OPENQUOTA_API_KEY=
# The /llm root, NOT /llm/v1 — we call the native Gemini surface at
# <root>/v1beta/models/<model>:generateContent.
OPENQUOTA_BASE_URL=https://openquota.anands.dev/llm
# Must not contain ':' — it would collide with the ':generateContent' suffix,
# so the auto:<strategy> forms are unusable on this path.
# Asset naming is a vision task. This value overrides the legacy unified model.
OPENQUOTA_VISION_MODEL=auto
# Legacy fallback used only when OPENQUOTA_VISION_MODEL is absent.
OPENQUOTA_MODEL=auto

# Shared secret the Node backend must send in X-Internal-Token (empty disables).
INTERNAL_API_TOKEN=
# Comma-separated host allowlist for image fetches.
ALLOWED_IMAGE_HOSTS=res.cloudinary.com,cloudinary.com
# Local storage (backend STORAGE_PROVIDER=local): the backend serves the images, over http, from a
# loopback host. Set this to true and list that host in ALLOWED_IMAGE_HOSTS, for example
#   ALLOW_PRIVATE_IMAGE_HOSTS=true
#   ALLOWED_IMAGE_HOSTS=localhost,127.0.0.1
# Crops are then returned to the backend instead of being uploaded to Cloudinary, so the CLOUDINARY_*
# keys are not needed. Never enable this in production.
ALLOW_PRIVATE_IMAGE_HOSTS=false

# OpenCV detection tuning (optional; the values below are the defaults)
MIN_BOX_WIDTH=20
MIN_BOX_HEIGHT=20
MIN_BOX_AREA=400
BINARY_THRESH_VALUE=240
# An image counts as transparent only if it has an alpha channel and at least this
# fraction of pixels have alpha below the threshold.
TRANSPARENCY_ALPHA_THRESHOLD=250
TRANSPARENCY_MIN_FRACTION=0.01
