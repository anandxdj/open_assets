# OpenAssets: configuration for docker-compose.yml.
#
#   cp .env.example .env
#
# Docker Compose reads this file and gives each service only the variables it needs.
# (To run a service outside Docker, use that service's own .env.example instead:
# backend/.env.example, py_backend/.env.example, frontend/.env.example.)
#
# Never commit .env. Generate secrets with:   openssl rand -hex 32

# ── Which environment ───────────────────────────────────────────────────────
# production (default): the backend refuses to start with missing or placeholder
#   secrets, cookies are Secure, and API errors never include details.
# development: relaxed checks, for a trial run over plain http://localhost.
APP_ENV=production

# ── Images and ports ────────────────────────────────────────────────────────
# Registry namespace and tag that build-push.sh pushes and deploy-vps.sh pulls.
OA_REGISTRY=anando1
OA_VERSION=1.0.0
# Host ports for the web app and the API. Published on 127.0.0.1 only.
FRONTEND_PORT=3000
BACKEND_PORT=4000

# ── Public URLs ─────────────────────────────────────────────────────────────
# Where users reach the web app and the API (no trailing slash). NEXT_PUBLIC_* are
# baked into the frontend image when it is built: change them, then rebuild.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: more allowed browser origins (comma-separated, no path), and the browser
# extension origin, chrome-extension://<extension id>. Needed in production.
CORS_ORIGINS=
EXTENSION_ORIGINS=

# ── Secrets (required) ──────────────────────────────────────────────────────
# Two different values of 32+ characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Shared secrets between services; each is used by two services, so generate one each.
# Backend -> AI service:
INTERNAL_API_TOKEN=
# Web app (Studio refunds) -> backend:
INTERNAL_SERVICE_TOKEN=

# ── Cookies (the refresh token) ─────────────────────────────────────────────
# Leave empty for the defaults: production = Secure + SameSite=None, development =
# not Secure + Lax. Use COOKIE_SAMESITE=lax when the web app and API share a
# registrable domain (app.example.com + api.example.com). SameSite=none needs HTTPS.
COOKIE_SECURE=
COOKIE_SAMESITE=
COOKIE_DOMAIN=

# ── Data ────────────────────────────────────────────────────────────────────
# MongoDB and Redis run in this stack (named volumes mongo-data and redis-data).
MONGO_DB_NAME=open_assets
# Optional: use a managed MongoDB (for example Atlas) instead of the bundled one.
# MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net

# ── Object storage (pick one) ───────────────────────────────────────────────
# cloudinary (default) or imagekit. Without the active provider's credentials the stack still
# starts (the backend logs a warning), but uploads fail and AI enhance says "not configured".
# The AI service uploads crops to Cloudinary. (STORAGE_PROVIDER=local, files on the backend's disk,
# is for running from source: see "Local storage" in the README. It is not wired into this compose
# file, and production refuses it unless ALLOW_LOCAL_STORAGE=1.)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# AI service: only fetch images from these hosts (comma-separated).
ALLOWED_IMAGE_HOSTS=res.cloudinary.com,cloudinary.com

# ── Sign-in and email ───────────────────────────────────────────────────────
# Google sign-in (optional; set all three or none). GOOGLE_CALLBACK_URL is the
# backend's public URL + /api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# Verification and password-reset emails. Without a key they are only logged.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=OpenAssets
# Token lifetimes (optional). Defaults: 15m and 7d.
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# ── AI providers ────────────────────────────────────────────────────────────
# Asset naming (AI service): Open Quota first, then Gemini, then plain asset_001 names.
OPENQUOTA_API_KEY=
# The /llm root, used by the AI service. (The web app uses OPENQUOTA_BASE_URL below.)
OPENQUOTA_PY_BASE_URL=https://openquota.anands.dev/llm
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Studio and AniBuddy (web app): Open Quota first, OpenRouter as the fallback.
OPENROUTER_API_KEY=
# 1 returns canned results instead of calling a provider (testing only).
OPENROUTER_MOCK=0
OPENQUOTA_BASE_URL=https://openquota.anands.dev/llm/v1
# Model/profile overrides. Empty uses the built-in defaults; see frontend/.env.example
# for what each one does.
OPENQUOTA_MODEL=
OPENQUOTA_TEXT_MODEL=
OPENQUOTA_VISION_MODEL=
OPENROUTER_FALLBACK_MODEL=
ANIBUDDY_PROMPT_OPENQUOTA_MODEL=
ANIBUDDY_PROMPT_OPENQUOTA_FALLBACK_MODEL=
ANIBUDDY_RIG_OPENQUOTA_MODEL=
ANIBUDDY_RIG_OPENQUOTA_FALLBACK_MODEL=
ANIBUDDY_ANIMATE_OPENQUOTA_MODEL=
ANIBUDDY_ANIMATE_OPENQUOTA_FALLBACK_MODEL=

# AI service: OpenCV detection tuning (optional; these are the defaults).
MIN_BOX_WIDTH=20
MIN_BOX_HEIGHT=20
MIN_BOX_AREA=400
BINARY_THRESH_VALUE=240
TRANSPARENCY_ALPHA_THRESHOLD=250
TRANSPARENCY_MIN_FRACTION=0.01

# ── VPS with Traefik (see docker-compose.traefik.yml) ───────────────────────
# Uncomment to layer the Traefik routing onto the stack for plain `docker compose`:
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# TRAEFIK_FRONTEND_HOST=openassets.example.com
# TRAEFIK_BACKEND_HOST=api.openassets.example.com
# Entrypoint to listen on (web = HTTP, websecure = HTTPS) and the TLS flag. Certificates
# are issued by the resolver configured in Traefik (see docker-compose.traefik.yml).
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_TLS=true
