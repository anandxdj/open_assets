{
  "version": 1,
  "description": "AniBuddy v5 archetype rig priors (§10). One table per archetype: role vocabulary, joint topology expectations, default deformer per part role, and attach-slot conventions. Consumed by semantics/rig stages; never invent roles outside the schema PartRole / JointRole enums.",
  "fallbackDeformer": "rigid",
  "archetypes": {
    "humanoid": {
      "id": "humanoid",
      "label": "Humanoid",
      "summary": "Bipedal cutout: axial spine plus four limb chains; mesh limbs/torso, rigid extremities, lattice hair/cape.",
      "partRoles": [
        "head", "face", "hair", "torso", "pelvis",
        "armUpper", "armLower", "hand",
        "legUpper", "legLower", "foot",
        "eye", "jaw", "ear", "cape", "accessory",
        "other"
      ],
      "jointRoles": [
        "root", "spine", "neck", "head",
        "limbUpper", "limbLower", "limbTip",
        "eye", "jaw", "ear", "other"
      ],
      "defaultDeformerByPartRole": {
        "head": "mesh",
        "face": "mesh",
        "hair": "lattice",
        "torso": "mesh",
        "pelvis": "mesh",
        "armUpper": "mesh",
        "armLower": "mesh",
        "hand": "rigid",
        "legUpper": "mesh",
        "legLower": "mesh",
        "foot": "rigid",
        "eye": "rigid",
        "jaw": "rigid",
        "ear": "rigid",
        "cape": "lattice",
        "accessory": "rigid",
        "other": "rigid"
      },
      "topology": {
        "style": "hierarchical",
        "allowEmptySkeleton": false,
        "expectedDepth": { "min": 3, "max": 8 },
        "rootJointRole": "root",
        "patterns": [
          {
            "id": "axial",
            "description": "root → pelvis(spine) → spine → neck → head",
            "jointRoleSequence": ["root", "spine", "spine", "neck", "head"],
            "minOccurrences": 1,
            "maxOccurrences": 1
          },
          {
            "id": "limb",
            "description": "limbUpper → limbLower → limbTip hanging off spine/root",
            "jointRoleSequence": ["limbUpper", "limbLower", "limbTip"],
            "hangsFromJointRoles": ["spine", "root"],
            "minOccurrences": 0,
            "maxOccurrences": 4,
            "ikChainLengthOnTip": 2
          }
        ],
        "notes": "Exactly one root. Tips get ikChainLength 2 so an IK drag bends the elbow/knee rather than translating the whole limb."
      },
      "ikDefaultsByJointRole": {
        "limbTip": 2
      },
      "attachSlots": [
        {
          "hostPartRole": "torso",
          "slotName": "neck",
          "typicalChildPartRoles": ["head"],
          "positionHint": { "x": 0.5, "y": 0.05 }
