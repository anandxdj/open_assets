    "creature": {
      "id": "creature",
      "label": "Creature",
      "summary": "Quadruped / winged / tailed: spine chain of 3–6 segments; limbs off front/rear; tail and tentacle use spline.",
      "partRoles": [
        "head", "face", "hair", "torso", "pelvis",
        "armUpper", "armLower", "hand",
        "legUpper", "legLower", "foot",
        "eye", "jaw", "ear", "cape", "accessory",
        "neck", "tail", "wing", "fin", "horn", "paw", "snout", "shell", "tentacle",
        "other"
      ],
      "jointRoles": [
        "root", "spine", "neck", "head",
        "limbUpper", "limbLower", "limbTip",
        "tail", "wing", "fin", "horn", "tentacleSegment",
        "eye", "jaw", "ear", "digit", "other"
      ],
      "defaultDeformerByPartRole": {
        "head": "mesh",
        "face": "mesh",
        "hair": "lattice",
        "torso": "mesh",
        "pelvis": "mesh",
        "armUpper": "mesh",
        "armLower": "mesh",
        "hand": "rigid",
        "legUpper": "mesh",
        "legLower": "mesh",
        "foot": "rigid",
