      "topology": {
        "style": "hierarchical",
        "allowEmptySkeleton": false,
        "expectedDepth": { "min": 2, "max": 12 },
        "rootJointRole": "root",
        "patterns": [
          {
            "id": "spine",
            "description": "root → spine chain of 3–6 segments (snake = spine only, no limbs)",
            "jointRoleSequence": ["root", "spine"],
            "spineSegmentCount": { "min": 3, "max": 6 },
            "minOccurrences": 1,
            "maxOccurrences": 1
          },
          {
            "id": "limb",
            "description": "limbUpper → limbLower → limbTip off front/rear spine",
            "jointRoleSequence": ["limbUpper", "limbLower", "limbTip"],
            "hangsFromJointRoles": ["spine", "root"],
            "minOccurrences": 0,
            "maxOccurrences": 8,
            "ikChainLengthOnTip": 2
          },
          {
            "id": "neck",
            "description": "neck chain toward head",
            "jointRoleSequence": ["neck", "head"],
            "hangsFromJointRoles": ["spine", "root"],
            "minOccurrences": 0,
            "maxOccurrences": 1
          },
          {
            "id": "tail",
            "description": "tail joint chain off rear spine",
            "jointRoleSequence": ["tail"],
            "hangsFromJointRoles": ["spine", "root"],
            "minOccurrences": 0,
            "maxOccurrences": 1
          },
          {
            "id": "tentacle",
            "description": "tentacleSegment chain for soft appendages",
            "jointRoleSequence": ["tentacleSegment"],
            "hangsFromJointRoles": ["spine", "root", "head"],
            "minOccurrences": 0,
            "maxOccurrences": 8
          },
          {
            "id": "wing",
            "description": "wing joints hanging off spine/torso",
            "jointRoleSequence": ["wing"],
            "hangsFromJointRoles": ["spine", "root"],
            "minOccurrences": 0,
            "maxOccurrences": 4
          }
        ],
        "notes": "A snake is a valid degenerate: spine chain, zero limbs. Tail/tentacle parts default to spline deformers."
      },
      "ikDefaultsByJointRole": {
        "limbTip": 2
      },
      "attachSlots": [
        {
          "hostPartRole": "torso",
          "slotName": "neck",
