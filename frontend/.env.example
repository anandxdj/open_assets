# Copy to .env.local for local runs. With Docker Compose these values come from the
# root .env (see ../.env.example).
#
# ── Public (browser-safe) ───────────────────────────────────────────────────
# Anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle at BUILD time,
# so changing it needs a rebuild (and a new image, see build-push.sh). Never put a
# secret in a NEXT_PUBLIC_ variable.
#
# Public URL of the backend API, reachable from the user's browser. Also the origin
# the Content-Security-Policy allows fetch() to.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of this web app, no trailing slash. Used for canonical URLs, the sitemap,
# robots.txt and social share images. If unset, production builds fall back to
# https://openassets.anands.dev and development uses http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Studio (server-only, used by /api/studio/* route handlers) ──────────────
# Express backend reachable from the Next server (credits consume/refund).
EXPRESS_INTERNAL_URL=http://localhost:4000
# Shared secret for refund calls — must match backend INTERNAL_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=change-me-service-token
# Server OpenRouter key powering the free tier. Users can BYOK to bypass.
# Also the FALLBACK provider for text/vision routes, and the only provider for
# the image routes (generate, extend).
OPENROUTER_API_KEY=
# Set to 1 to return deterministic fixtures instead of calling a provider
# (still exercises auth + credits + the client canvas pipeline).
OPENROUTER_MOCK=0

# ── Open Quota (primary provider for text/vision routes) ────────────────────
# Unified key for the freellmapi proxy. Empty = OpenRouter-only, unchanged
# behaviour. Requests carrying a user's own key (BYOK) never reach Open Quota.
OPENQUOTA_API_KEY=
# OpenAI-compatible surface. Note py_backend uses the /llm root instead.
OPENQUOTA_BASE_URL=https://openquota.anands.dev/llm/v1
# Routing strategy, not a model id. `auto` follows the operator's dashboard
# fallback chain; auto:smart / auto:fast / auto:reliable ignore that chain.
# Specialized OpenQuota routing profiles.
OPENQUOTA_TEXT_MODEL=auto:smart
OPENQUOTA_VISION_MODEL=auto
# AniBuddy runs entirely through Open Quota: Gemini is tried first, then the
# proxy's vision/text-safe auto profile. No OpenRouter key or model is used.
ANIBUDDY_PROMPT_OPENQUOTA_MODEL=google/gemini-2.5-flash
ANIBUDDY_PROMPT_OPENQUOTA_FALLBACK_MODEL=auto
ANIBUDDY_RIG_OPENQUOTA_MODEL=google/gemini-2.5-flash
ANIBUDDY_RIG_OPENQUOTA_FALLBACK_MODEL=auto
ANIBUDDY_ANIMATE_OPENQUOTA_MODEL=google/gemini-2.5-flash
ANIBUDDY_ANIMATE_OPENQUOTA_FALLBACK_MODEL=auto
# Legacy fallback used only when a specialized setting is absent.
OPENQUOTA_MODEL=auto
# Used only if OpenQuota cannot serve a text/vision request. This must be an
# OpenRouter model id (unlike OPENQUOTA_MODEL, which is an OpenQuota profile).
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash
