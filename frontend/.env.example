# Browser-safe config only — anything prefixed NEXT_PUBLIC_ ships to the client.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Gate on the AniBuddy rig/timeline editor route. Off by default, including in
# production: `app/(anibuddy)/layout.tsx` keeps serving ComingSoonPage until this
# is on, so enabling the editor is a deploy-time environment change rather than a
# code change (F9 §15). Independent of ANIBUDDY_PIPELINE_ENABLED below — this one
# decides whether the UI renders, that one whether the proposal routes answer.
NEXT_PUBLIC_ANIBUDDY_EDITOR_ENABLED=0

# ── Studio (server-only, used by /api/studio/* route handlers) ──────────────
# Express backend reachable from the Next server (credits consume/refund, and the
# AniBuddy annotate proxy — this app holds no py_backend credential of its own).
EXPRESS_INTERNAL_URL=http://localhost:4000
# Shared secret for every server-to-server call between this app and the gateway, in
# both directions: refunds, reconciliation and the AniBuddy annotate proxy outbound,
# and the gateway's AniBuddy vision calls (critique, motion) inbound. Those two routes
# are internal and unmetered, so this token is the whole of their access control.
# Must match the backend's INTERNAL_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=change-me-service-token
# Server OpenRouter key powering the free tier. Users can BYOK to bypass.
# Also the FALLBACK provider for text/vision routes, and the only provider for
# the image routes (generate, extend).
OPENROUTER_API_KEY=
# Set to 1 to return deterministic fixtures instead of calling a provider
# (still exercises auth + credits + the client canvas pipeline).
OPENROUTER_MOCK=0

# ── Open Quota (primary provider for text/vision routes) ────────────────────
# Unified key for the freellmapi proxy. Empty = OpenRouter-only, unchanged
# behaviour. Requests carrying a user's own key (BYOK) never reach Open Quota.
OPENQUOTA_API_KEY=
# OpenAI-compatible surface. Note py_backend uses the /llm root instead.
OPENQUOTA_BASE_URL=https://openquota.anands.dev/llm/v1
# Routing strategy, not a model id. `auto` follows the operator's dashboard
# fallback chain; auto:smart / auto:fast / auto:reliable ignore that chain.
# Specialized OpenQuota routing profiles.
OPENQUOTA_TEXT_MODEL=auto:smart
OPENQUOTA_VISION_MODEL=auto
# AniBuddy runs entirely through Open Quota: Gemini is tried first, then the
# proxy's vision/text-safe auto profile. No OpenRouter key or model is used.
# Only the concept interview reads these two. The v3 `rig-analysis` and `animate`
# routes read a pair each as well; both routes were deleted by the migration order
# (F9 §15) and their variables went with them.
ANIBUDDY_PROMPT_OPENQUOTA_MODEL=google/gemini-2.5-flash
ANIBUDDY_PROMPT_OPENQUOTA_FALLBACK_MODEL=auto
# The v5 proposal calls (semantics, motion, critique) share one vision model, so the
# three revalidators tune against one failure profile. Must match the backend's
# ANIBUDDY_PROPOSAL_MODEL: the gateway pre-authorizes a queued stage's credits against
# that id, and a mismatch would name a model this deployment never requests.
ANIBUDDY_PROPOSAL_MODEL=google/gemini-2.5-flash
ANIBUDDY_PROPOSAL_FALLBACK_MODEL=auto
# Off by default: the AI layer lands without being reachable (F9 §15).
ANIBUDDY_PIPELINE_ENABLED=0
# Legacy fallback used only when a specialized setting is absent.
OPENQUOTA_MODEL=auto
# Used only if OpenQuota cannot serve a text/vision request. This must be an
# OpenRouter model id (unlike OPENQUOTA_MODEL, which is an OpenQuota profile).
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash
